+.expedition-map .map-camp circle{stroke:#e4b26a}.expedition-map .map-camp text{fill:#f1cf94}
+.expedition-map .map-base circle{fill:#1b2530;stroke:var(--ui-gold);stroke-width:1.6}.expedition-map .map-base text{fill:var(--ui-gold)}
+.expedition-map .map-boss circle{fill:#2a0f18;stroke:var(--ui-red);stroke-width:2}.expedition-map .map-boss text{fill:#ff9db0;font-size:14px}
