+function oneHit(damage,shield){const s=qaFixture('battle');s.shield=shield;for(const h of Object.values(s.heroes)){h.stress=0;h.equipment.accessory=null;}
+ s.battle.enemies=s.battle.enemies.slice(0,1);s.battle.enemies[0].intent={name:'시험',damage,stress:0,target:'lohen',tag:'시험'};s.battle.enemies[0].stun=0;s.battle.enemies[0].hp=999;s.battle.enemies[0].maxHp=999;
+ go(s,{type:'endTurn'});return s;}
+
+test('damage that passes the shared shield adds stress to the targeted hero; fully blocked hits add none',()=>{
+ const hit=oneHit(12,0);assert.equal(hit.heroes.lohen.stress,Math.ceil(12*STRESS_PER_DAMAGE));assert.equal(hit.heroes.durin.stress,0);
+ const blocked=oneHit(12,20);assert.equal(blocked.heroes.lohen.stress,0);
+ const partial=oneHit(12,8);assert.equal(partial.heroes.lohen.stress,Math.ceil(4*STRESS_PER_DAMAGE));
+});
