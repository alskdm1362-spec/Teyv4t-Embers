+ --ui-clip-s:polygon(var(--ui-cut-s) 0,100% 0,100% calc(100% - var(--ui-cut-s)),calc(100% - var(--ui-cut-s)) 100%,0 100%,0 var(--ui-cut-s));
+}
+
+/* ---------- Buttons ---------- */
+:where(button.primary,button.flat,button.small,.dialogue-controls button,.field-reward-actions button,.card-reward-actions button,.tutorial-note button,.pause-menu button,.ending-actions button,.defeat-actions button,.refinement-scene>button,.event-removal>button){
+ position:relative;clip-path:var(--ui-clip-s);border:1px solid var(--ui-line)!important;border-radius:0!important;
+ background:linear-gradient(135deg,transparent 4.3px,var(--ui-line) 4.3px 5.3px,transparent 5.3px) top left/9px 9px no-repeat,
+  linear-gradient(-45deg,transparent 4.3px,var(--ui-line) 4.3px 5.3px,transparent 5.3px) bottom right/9px 9px no-repeat,
+  linear-gradient(180deg,#18222ee6,#0a0f17f0)!important;
+ color:var(--ui-ink)!important;letter-spacing:.04em;font-weight:500;box-shadow:inset 0 1px 0 #ffffff0d!important;
+ transition:filter .15s,background .15s,border-color .15s,transform .12s;
+}
+:where(button.primary,button.flat,button.small,.dialogue-controls button,.field-reward-actions button,.card-reward-actions button,.tutorial-note button,.pause-menu button,.ending-actions button,.defeat-actions button,.refinement-scene>button,.event-removal>button):hover:not(:disabled){border-color:var(--ui-line-strong)!important;filter:brightness(1.18)}
+:where(button.primary,button.flat,button.small,.dialogue-controls button,.field-reward-actions button,.card-reward-actions button,.tutorial-note button,.pause-menu button):active:not(:disabled){transform:translateY(1px)}
+button.primary{
+ background:linear-gradient(135deg,transparent 4.3px,#fff3d0 4.3px 5.3px,transparent 5.3px) top left/9px 9px no-repeat,
+  linear-gradient(-45deg,transparent 4.3px,#fff3d0 4.3px 5.3px,transparent 5.3px) bottom right/9px 9px no-repeat,
+  linear-gradient(180deg,#f1e2bb 0%,#cdb17a 55%,#b39461 100%)!important;
+ border-color:#f6e7c2!important;color:#1b1409!important;font-weight:700;text-shadow:none!important;
+ box-shadow:inset 0 1px 0 #fff9,0 0 18px #e3cc9733!important;
+}
+button.primary:disabled,button.flat:disabled,button.small:disabled{filter:grayscale(.7) brightness(.6);cursor:default}
+:is(button.primary,button.flat,button.small):focus-visible{outline:none;box-shadow:0 0 0 2px #0b0f17,0 0 0 3px var(--ui-teal)!important}
+/* Close buttons: a small cut-corner square instead of a bare glyph */
+.surface-close,.modern-surface .surface-close{clip-path:var(--ui-clip-s);border:1px solid var(--ui-line-dim)!important;background:#0a0f17cc!important}
+.surface-close:hover,.modern-surface .surface-close:hover{border-color:var(--ui-line-strong)!important;background:#1a2430!important}
+
+/* ---------- Windows ---------- */
+.modal.modern-surface,.modal{
+ clip-path:var(--ui-clip);background:
+  linear-gradient(135deg,transparent 6.4px,var(--ui-line) 6.4px 7.5px,transparent 7.5px) top left/14px 14px no-repeat,
+  linear-gradient(-45deg,transparent 6.4px,var(--ui-line) 6.4px 7.5px,transparent 7.5px) bottom right/14px 14px no-repeat,
+  var(--ui-panel)!important;
+ border:1px solid var(--ui-line-dim)!important;box-shadow:0 30px 90px #000c,inset 0 1px 0 #ffffff0a!important;
+}
+.modern-surface>.surface-header{border-bottom:1px solid var(--ui-line-dim)!important;position:relative}
