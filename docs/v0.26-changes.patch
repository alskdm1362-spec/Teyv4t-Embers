+.surface-header .surface-kicker,.eyebrow{color:var(--ui-gold)!important;letter-spacing:.32em!important}
+:is(.dialogue-box,.tutorial-note,.event-narrative,.travel-minimap,.merchant-line,.field-loot,.recruit-response){
+ clip-path:var(--ui-clip);background:
+  linear-gradient(135deg,transparent 6.4px,var(--ui-line) 6.4px 7.5px,transparent 7.5px) top left/14px 14px no-repeat,
+  linear-gradient(-45deg,transparent 6.4px,var(--ui-line) 6.4px 7.5px,transparent 7.5px) bottom right/14px 14px no-repeat,
